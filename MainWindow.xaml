<Window x:Class="BOLGAMES.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOLGAMES" 
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2a475e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#66c0f4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d5a73"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border Background="#1b2838" BorderBrush="#2a475e" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#171a21" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text=" BOLGAMES" FontSize="16" FontWeight="Bold" Foreground="#66c0f4" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="─" Style="{StaticResource WinBtn}" Click="Minimize_Click" ToolTip="Свернуть"/>
                        <Button x:Name="MaximizeBtn" Content="🗖" Style="{StaticResource WinBtn}" Click="Maximize_Click" ToolTip="Развернуть"/>
                        <Button Content="✕" Style="{StaticResource CloseBtn}" Click="Close_Click" ToolTip="Закрыть"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,138,0">
                        <Button x:Name="RefreshBtn" Content="🔄 Обновить" Padding="12,6" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="RefreshBtn_Click"/>
                        <Button x:Name="SettingsBtn" Content="⚙ Настройки" Padding="12,6" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="SettingsBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#171a21" BorderBrush="#2a475e" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="10">
                            <TextBox x:Name="SearchBox" Background="#2a475e" Foreground="White" BorderBrush="#66c0f4" BorderThickness="1" Padding="8" FontSize="13" TextChanged="SearchBox_TextChanged"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GamesList"/></ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" x:Name="GamePage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid x:Name="GameBanner" Height="350">
                                <Image x:Name="BannerImage" Stretch="UniformToFill" Opacity="0.6"/>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#331b2838" Offset="0"/><GradientStop Color="#E61b2838" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Grid VerticalAlignment="Bottom">
                                    <Border Background="#000000" Opacity="0.5" Padding="30,20">
                                        <StackPanel>
                                            <TextBlock x:Name="GameTitle" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/></StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Горизонтальная лента скриншотов (как в Steam) -->
                            <Border x:Name="ScreenshotsBorder" Background="#2a475e" CornerRadius="4" Padding="15" Margin="30,20,30,0" Visibility="Collapsed">
                                <ScrollViewer x:Name="ScreenshotsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ScreenshotsPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Красивые теги-бейджи -->
                            <StackPanel x:Name="GameTagsPanel" Orientation="Horizontal" Margin="30,10,30,20"/>

                            <Grid Margin="30,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <Border Background="#2a475e" CornerRadius="4" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Об игре" FontSize="20" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="GameDescription" FontSize="14" Foreground="#c7d5e0" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,20"/>
<TextBlock x:Name="GameDescriptionExtended" FontSize="13" Foreground="#8f98a0" TextWrapping="Wrap" LineHeight="20" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#2a475e" CornerRadius="4" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="Последние обновления" FontSize="20" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="GameNews" FontSize="13" Foreground="#8f98a0" TextWrapping="Wrap" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Border Background="#2a475e" CornerRadius="4" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Информация" FontSize="18" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,15"/>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Разработчик:" Foreground="#8f98a0" Grid.Column="0"/><TextBlock x:Name="GameDeveloper" Foreground="White" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Издатель:" Foreground="#8f98a0" Grid.Column="0"/><TextBlock x:Name="GamePublisher" Foreground="White" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Дата выхода:" Foreground="#8f98a0" Grid.Column="0"/><TextBlock x:Name="GameReleaseDate" Foreground="White" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Размер:" Foreground="#8f98a0" Grid.Column="0"/><TextBlock x:Name="GameSize" Foreground="White" Grid.Column="1"/>
                                            </Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Версия:" Foreground="#8f98a0" Grid.Column="0"/><TextBlock x:Name="GameVersion" Foreground="White" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Расположение:" Foreground="#8f98a0" Grid.Column="0"/><TextBlock x:Name="GameLocation" Foreground="White" Grid.Column="1" TextWrapping="Wrap"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#2a475e" CornerRadius="4" Padding="20">
                                        <StackPanel>
                                            <Button x:Name="InstallBtn" Content="УСТАНОВИТЬ" Style="{StaticResource SteamButton}" Width="260" Height="50" FontSize="16" Click="InstallBtn_Click" Margin="0,0,0,10"/>
                                            <Button x:Name="MoveBtn" Content="📁 ПЕРЕМЕСТИТЬ" Style="{StaticResource SecondaryButton}" Width="260" Height="40" Click="MoveBtn_Click" Visibility="Collapsed" Margin="0,0,0,10"/>
                                            <Grid x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <ProgressBar x:Name="DownloadProgress" Height="20" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="DownloadProgressText" FontSize="12" Foreground="#c7d5e0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button x:Name="CancelDownloadBtn" Content="Отменить" Style="{StaticResource SecondaryButton}" Width="260" Height="35" Click="CancelBtn_Click" Visibility="Collapsed" Margin="0,0,0,10"/>
                                            <Button x:Name="SkipBtn" Content="Пропустить и играть" Style="{StaticResource SecondaryButton}" Width="260" Height="35" Click="SkipBtn_Click" Visibility="Collapsed" Margin="0,0,0,10"/>
                                            <Button x:Name="DeleteBtn" Content=" Удалить игру" Style="{StaticResource SecondaryButton}" Width="260" Height="40" Click="DeleteBtn_Click" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Column="1" x:Name="SettingsPage" Visibility="Collapsed" Background="#1b2838">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40" MaxWidth="800">
                            <TextBlock Text=" Настройки библиотек" FontSize="32" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,10"/>
                            <TextBlock Text="Добавьте папки на разных дисках, где будут храниться игры" FontSize="14" Foreground="#8f98a0" Margin="0,0,0,30" TextWrapping="Wrap"/>
                            <Border Background="#2a475e" CornerRadius="4" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Папки библиотек:" FontSize="16" FontWeight="Bold" Foreground="#c7d5e0" Margin="0,0,0,15"/>
                                    <StackPanel x:Name="LibrariesList" Margin="0,0,0,15"/>
                                    <Button x:Name="AddLibraryBtn" Content="+ Добавить папку" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="15,8" Click="AddLibraryBtn_Click"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="WarningBorder" Background="#3d1f1f" CornerRadius="4" Padding="15" Margin="0,20,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="WarningText" FontSize="13" Foreground="#ff6b6b" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="← Назад" Style="{StaticResource SecondaryButton}" Padding="15,8" Click="BackFromSettings_Click"/>
                            </StackPanel>
                            
                            <!-- БЛОК О ПРОГРАММЕ (ТЕПЕРЬ СТРОГО ВНУТРИ StackPanel) -->
                            <Border Background="#1e2a38" CornerRadius="4" Padding="20" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="О программе" FontSize="18" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Название:" Foreground="#8f98a0" Grid.Column="0"/>
                                        <TextBlock Text="BOLGAMES Launcher" Foreground="White" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Версия:" Foreground="#8f98a0" Grid.Column="0"/>
                                        <TextBlock x:Name="AboutVersion" Foreground="White" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Разработчик:" Foreground="#8f98a0" Grid.Column="0"/>
                                        <TextBlock Text="bmv1986" Foreground="White" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="GitHub:" Foreground="#8f98a0" Grid.Column="0"/>
                                        <TextBlock Text="github.com/bmv1986" Foreground="#66c0f4" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- КОНЕЦ БЛОКА О ПРОГРАММЕ -->

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="InstallPathDialog" Visibility="Collapsed" Panel.ZIndex="100" Grid.ColumnSpan="2" Background="#CC000000">
                    <Border Background="#1b2838" CornerRadius="8" Padding="30" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#66c0f4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Выберите диск для установки" FontSize="22" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,20"/>
                            <TextBlock x:Name="InstallPathDialogText" FontSize="14" Foreground="#c7d5e0" Margin="0,0,0,20" TextWrapping="Wrap"/>
                            <ComboBox x:Name="InstallPathSelector" Style="{StaticResource DarkComboBox}" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Padding="15,8" Margin="0,0,10,0" Click="CancelInstallPath_Click"/>
                                <Button x:Name="ConfirmInstallBtn" Content="Установить" Style="{StaticResource SteamButton}" Padding="20,10" Click="ConfirmInstallPath_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="MovePathDialog" Visibility="Collapsed" Panel.ZIndex="100" Grid.ColumnSpan="2" Background="#CC000000">
                    <Border Background="#1b2838" CornerRadius="8" Padding="30" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#66c0f4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Переместить игру на другой диск" FontSize="22" FontWeight="Bold" Foreground="#66c0f4" Margin="0,0,0,20"/>
                            <TextBlock x:Name="MovePathDialogText" FontSize="14" Foreground="#c7d5e0" Margin="0,0,0,20" TextWrapping="Wrap"/>
                            <ComboBox x:Name="MovePathSelector" Style="{StaticResource DarkComboBox}" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Padding="15,8" Margin="0,0,10,0" Click="CancelMovePath_Click"/>
                                <Button x:Name="ConfirmMoveBtn" Content="Переместить" Style="{StaticResource SteamButton}" Padding="20,10" Click="ConfirmMovePath_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>